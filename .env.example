# ====================================================
# Study Gen AI â€” Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file.
# ====================================================

# --- Application ---
APP_NAME=Study Gen AI
APP_ENV=development
APP_DEBUG=true

# --- Security ---
# JWT secret key â€” generate a strong random string
# You can generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-strong-random-secret
# Token expiry in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# JWT algorithm
ALGORITHM=HS256

# --- Database ---
# SQLite for development
DATABASE_URL=sqlite:///./database/study_gen_ai.db
# PostgreSQL can be used later:
# DATABASE_URL=postgresql://user:password@localhost:5432/Study Gen AI

# --- Uploads ---
# Directory where uploaded study materials are stored
UPLOAD_DIR=backend/uploads
# Maximum upload size in MB
MAX_UPLOAD_SIZE_MB=20

# --- Vector Store ---
# ChromaDB storage directory
VECTOR_DB_PATH=vector_store

# --- AI / LLM Provider (Google Gemini) ---
# Get a key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.6-flash

# --- Embeddings ---
EMBEDDING_MODEL=gemini-embedding-001
# Set to "gemini" to use Gemini embeddings, or "deterministic" for a stable
# offline embedder (recommended for free-tier API keys that are rate-limited).
EMBEDDING_BACKEND=deterministic

# --- RAG ---
# Number of relevant chunks to retrieve
RAG_TOP_K=5
# Minimum similarity score for a chunk to be included (0.0 - 1.0)
RAG_SIMILARITY_THRESHOLD=0.1

# --- CORS ---
# Frontend origin(s) allowed to call the API
FRONTEND_URL=http://localhost:5173